<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Cannon" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/cannon_navy</item>
        <item name="colorPrimaryVariant">@color/cannon_navy_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/cannon_red</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/cannon_navy_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Widget.Cannon.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg_selector</item>
        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="chipStrokeColor">@color/chip_stroke_selector</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">50dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinTouchTargetSize">40dp</item>
    </style>

    <style name="Widget.Cannon.Chip.Action" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipBackgroundColor">@color/surface</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="chipStrokeColor">@color/card_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">50dp</item>
        <item name="chipMinTouchTargetSize">40dp</item>
    </style>

    <style name="Widget.Cannon.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/cannon_navy_surface</item>
    </style>
</resources>
